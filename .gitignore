# JAR files (too large, user-provided)
input/**/*.jar

# Decompiled source (too large for git, regenerated from JAR)
artifacts/decompiled/
artifacts/*/decompiled/

# Node modules and build output (per-branch site/mcp)
**/node_modules/
site/*/dist/

# Synced content docs (generated by sync script, not source)
site/*/src/content/docs/

# Gradle build outputs
tools/.gradle/
tools/build/
tools/app/.gradle/
tools/app/build/
tools/app/artifacts/

# IDE files
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.DS_Store

# Gradle wrapper (optional — can be committed, but regenerated easily)
# tools/gradle/
