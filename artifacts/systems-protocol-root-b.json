    "serialization": {
      "overview": "All struct types follow a uniform binary serialization pattern over Netty ByteBuf. Each type declares NULLABLE_BIT_FIELD_SIZE, FIXED_BLOCK_SIZE, VARIABLE_FIELD_COUNT, VARIABLE_BLOCK_START, and MAX_SIZE constants. Serialization layout: [nullable bit flags] [fixed-size fields at known offsets] [offset table for variable fields] [variable-length data block]. Strings use VarInt-prefixed UTF-8 via PacketIO. Arrays use VarInt count prefix. Dictionaries use VarInt count then key-value pairs. Polymorphic types use VarInt type ID prefix. Validation checks buffer bounds, string lengths (max 4096000), array lengths (max 4096000).",
      "patterns": [
        {
          "name": "Nullable bit fields",
          "description": "First N bytes encode which nullable fields are present, using bit flags (nullBits & 1, nullBits & 2, etc.)."
        },
        {
          "name": "Fixed block",
          "description": "Non-nullable primitive fields and nullable fixed-size structs are written at known offsets within the fixed block."
        },
        {
          "name": "Variable offset table",
          "description": "After the fixed block, 4-byte LE int offsets point into the variable data block. -1 indicates null. Offsets are relative to the variable block start."
        },
        {
          "name": "Variable data block",
          "description": "Variable-length data (strings, arrays, nested variable structs, dictionaries) written sequentially."
        },
        {
          "name": "VarInt polymorphism",
          "description": "Abstract types (Interaction, Selector, ParamValue, ComponentUpdate) prefix data with a VarInt type ID to select the concrete subtype."
        },
        {
          "name": "Little-endian",
          "description": "All multi-byte integers and floats use little-endian byte order (getIntLE, getFloatLE, getDoubleLE, getLongLE)."
        }
      ]
    },
